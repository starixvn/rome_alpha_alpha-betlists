<?xml version="1.0"?>
<AuthorizationSection
  fullpermission="[A],[B],[C],[D],[E],[G],[H],[L]"
  custIdQueryStringParamNameMapping="custid,CustId,custId"
  custIdJsonParamNameMapping="txtCustomerObject,newCustomer"
  ignoreUrls=""
  cachedExpireTime="30"
  kickOutUrl="~/default/kickout">
  <!-- [E]: Reports -->
  <!-- [D]: Total Bets -->
  <!-- [L]: Bet Lists -->
  <GroupPageAccess roleid="2" name="Agent">
    <PageAccesses>
      <add id="1.01.01" permission="[E]" mainfuncname="BetList" subfuncname="Winloss" url="WinLoss" ischeckbelonging="true" isallowtodobythemselves="true" isviewedbygroupheadline="true" />
      <add id="1.01.02" permission="[E]" mainfuncname="BetList" subfuncname="RunningBetList" url="RunningBetList" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.01.03" permission="[E]" mainfuncname="BetList" subfuncname="MemberBetList" url="MemberBetList" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.01.04.01" permission="[E],[L]" mainfuncname="BetList" subfuncname="Parlay" url="Parlay/MixParlay" ischeckbelonging="true" isallowtodobythemselves="true" isviewedbygroupheadline="true" />
      <add id="1.01.04.02" permission="[E],[L]" mainfuncname="BetList" subfuncname="Parlay" url="Parlay/ComboParlay" ischeckbelonging="true" isallowtodobythemselves="true" isviewedbygroupheadline="true" />
      <add id="1.01.04.03" permission="[E],[L]" mainfuncname="BetList" subfuncname="Parlay" url="Parlay/ComboParlayDetail" ischeckbelonging="true" isallowtodobythemselves="true" isviewedbygroupheadline="true" />
      <add id="1.01.04.04" permission="[E],[L]" mainfuncname="BetList" subfuncname="Parlay" url="Parlay/ComboParlayDetailExcel" ischeckbelonging="true" isallowtodobythemselves="true" isviewedbygroupheadline="true" />
      <add id="1.01.05" permission="[L]" mainfuncname="BetList" subfuncname="CancelledBet" url="CancelledBet" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.01.07" permission="[L]" mainfuncname="BetList" subfuncname="LastBets" url="LastBets" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.01.08" permission="[E]" mainfuncname="BetList" subfuncname="DailyStatement" url="DailyStatement" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.01.09" permission="[E]" mainfuncname="BetList" subfuncname="WinLossByMatch" url="WinLossByMatch" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.01.10" permission="[E]" mainfuncname="BetList" subfuncname="ParlayWinLossByMatch" url="ParlayWinLossByMatch" ischeckbelonging="true" isallowtodobythemselves="true" />

      <add id="1.01.11" permission="[L]" mainfuncname="BetList" subfuncname="CorrectScore" url="CorrectScore" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.01.12.01" permission="[L]" mainfuncname="BetList" subfuncname="BetListByBetType" url="BetListByBetType/Index" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.01.12.02" permission="[L]" mainfuncname="BetList" subfuncname="BetListByBetType" url="BetListByBetType/Excel" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.01.13" permission="[L]" mainfuncname="BetList" subfuncname="CombinationMixParlay" url="CombinationMixParlay" ischeckbelonging="true" isallowtodobythemselves="true" />

      <add id="1.01.14" permission="[D],[L]" mainfuncname="BetList" subfuncname="BetListByBetTypeAndMatch" url="BetListByBetTypeAndMatch" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.01.16" permission="[D],[E],[L]" mainfuncname="BetDetails" subfuncname="CasinoDetails" url="CasinoDetails" ischeckbelonging="true" isallowtodobythemselves="true" isviewedbygroupheadline="true" />
    </PageAccesses>
  </GroupPageAccess>

  <GroupPageAccess roleid="3" name="Master">
    <DeniedPages>
      <add url="LastBets" />
    </DeniedPages>
   
    <PageAccesses>      
    </PageAccesses>
  </GroupPageAccess>

  <GroupPageAccess roleid="4" name="Super">
    <DeniedPages>
      <add url="LastBets" />
    </DeniedPages>
  
    <PageAccesses>
      <add id="1.01.17" permission="[E]" mainfuncname="BetList" subfuncname="RiskAnalysisIPMatching" url="RiskAnalysisIPMatching" ischeckbelonging="true" isallowtodobythemselves="true" />
    </PageAccesses>
  </GroupPageAccess>
</AuthorizationSection>
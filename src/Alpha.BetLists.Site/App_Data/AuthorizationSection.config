<?xml version="1.0"?>
<AuthorizationSection
  fullpermission="[A],[B],[C],[D],[E],[G],[H]"
  custIdQueryStringParamNameMapping="custid,CustId,custId"
  custIdJsonParamNameMapping="txtCustomerObject,newCustomer"
  ignoreUrls=""
  cachedExpireTime="30"
  kickOutUrl="~/default/kickout">
  <!-- [E]: Reports -->
  <GroupPageAccess roleid="2" name="Agent">
    <PageAccesses>
      <add id="1.01.01" permission="[E]" mainfuncname="BetList" subfuncname="Winloss" url="WinLoss" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.01.02" permission="[E]" mainfuncname="BetList" subfuncname="RunningBetList" url="RunningBetList" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.01.03" permission="[E]" mainfuncname="BetList" subfuncname="MemberBetList" url="MemberBetList" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.01.04" permission="[E]" mainfuncname="BetList" subfuncname="Parlay" url="Parlay" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.01.05" permission="[E]" mainfuncname="BetList" subfuncname="CancelledBet" url="CancelledBet" ischeckbelonging="true" isallowtodobythemselves="true" />
      <add id="1.01.06" permission="[E]" mainfuncname="LastBets" subfuncname="LastBets" url="WinLoss" ischeckbelonging="true" isallowtodobythemselves="true" />
    </PageAccesses>
  </GroupPageAccess>

  <GroupPageAccess roleid="3" name="Master">
    <PageAccesses>
    </PageAccesses>
  </GroupPageAccess>

  <GroupPageAccess roleid="4" name="Super">
    <PageAccesses>
    </PageAccesses>
  </GroupPageAccess>
</AuthorizationSection>
{
  "Framework": "jasmine",
  "EnableCodeCoverage": "true",
  "Compile": {
    "Mode": "External",
    "Extensions": [ ".ts" ]
  },
  "CodeCoverageExcludes": [
    "*\\libs\\*"
  ],
  "CodeCoverageIgnores": [
    "*\\tests\\*"
  ],
  "TestHarnessLocationMode": "SettingsFileAdjacent",
  "References": [
    { "Path": "libs/jquery.js" },
    { "Path": "libs/jquery-blockui.js" },
    { "Path": "libs/jasmine.js" },
    { "Path": "libs/jasmine-jquery.js" },
    { "Path": "libs/bootstrap-modal.js" },
    { "Path": "libs/moment.js" },
    { "Path": "libs/datepicker.js" },
    { "Path": "libs/bootstrap-datetimepicker.js" },
    { "Path": "libs/nexDatePicker.js" },
    { "Path": "libs/multiselect.js" },

    { "Path": "../src/common/app-path.ts" },
    { "Path": "../src/common/popup-details.ts" },
    { "Path": "../src/common/utils.ts" },
    { "Path": "../src/betlist/choice/ticket-details/base-ticket-details.ts" },
    { "Path": "../src/betlist/choice/ticket-details/casino-ticket-details.ts" },
    { "Path": "../src/betlist/choice/ticket-details/sportsbook-ticket-details.ts" },
    { "Path": "../src/betlist/choice/ticket-details/other-ticket-details.ts" },
    { "Path": "../src/betlist/choice/score-map.ts" },

    { "Path": "../src/betlist/status/result-details/base-result-details.ts" },
    { "Path": "../src/betlist/status/result-details/sportsbook-result-details.ts" },
    { "Path": "../src/betlist/status/result-details/casino-result-details.ts" },
    { "Path": "../src/betlist/status/result-details/other-result-details.ts" },
    { "Path": "../src/betlist/status/ip-details.ts" },

    { "Path": "../src/components/daterangepicker.ts" },
    { "Path": "../src/components/productmultiselection.ts" },
    { "Path": "../src/components/single-selection-dropdown.ts" },

    { "Path": "../src/member-betlist/member-betlist.ts" },
    { "Path": "../src/running-betlist/running-betlist.ts" }
  ],
  "Tests": [
    {
      "Path": "app/choice",
      "Excludes": [ "**.js.map" ]
    },
    {
      "Path": "app/status",
      "Excludes": [ "**.js.map" ]
    },
    {
      "Path": "app/common",
      "Excludes": [ "**.js.map" ]
    },
    {
      "Path": "app/components",
      "Excludes": [ "**.js.map" ]
    },
    {
      "Path": "app/member-betlist",
      "Excludes": [ "**.js.map" ]
    },
    {
      "Path": "app/running-betlist",
      "Excludes": [ "**.js.map" ]
    }
  ]
}
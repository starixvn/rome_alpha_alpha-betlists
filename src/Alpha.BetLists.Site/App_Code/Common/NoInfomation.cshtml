﻿@using Alpha.BetLists.AppResources;
@helper Render(int colspan, bool withBody = true)
{
    if (withBody)
    {
        <tbody>
            <tr>
                <td colspan="@colspan" class="text-center">@Resources.NoInformationIsAvailable</td>
            </tr>
        </tbody>
    }
    else
    {
        <tr>
            <td colspan="@colspan" class="text-center">@Resources.NoInformationIsAvailable</td>
        </tr>
    }
}

@helper NewView(string href)
{
    <div class="switch-version">
        <a href="@href" class="btn-switch-version" target="main">
            <span class="icon-swap-horizontal"></span>
            <span class="text">@Alpha.BetLists.AppResources.Resources.NewView</span>
        </a>
    </div>
}

@helper ClassicView(string href)
{
    <a href="@href" class="link-switch-version" target="main">
        <span class="icon-swap-horizontal"></span>
        <span class="text">@Alpha.BetLists.AppResources.Resources.ClassicView</span>
    </a>
}

@helper Render(string selector, string inputPlaceHolder)
{
    <div class="tagsinput" id="@(selector)_tagsinput">
        <span class="tag-limit" id="@(selector)_taglimit"></span>
        <input type="text"
               class="tag-add"
               id="@(selector)_input"
               autocomplete="off"
               placeholder="@inputPlaceHolder" />
    </div>
}

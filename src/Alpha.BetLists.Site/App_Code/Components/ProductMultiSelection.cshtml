@using Alpha.BetLists.AppResources;
@using Alpha.BetLists.Site.ViewModels.Components;
@helper Render(ProductMultiSelectionViewModel model)
{
    <div class="form-group">
        <select id="dropdown-product"
                data-has-any-product="@model.GroupProducts.Any()"
                data-label-select-products="@Resources.SelectProducts"
                data-label-selected="@Resources.Selected"
                data-label-all-products="@Resources.AllProducts"
                data-label-there-is-no-product="@Resources.ThereIsNoProduct"
                data-language="@model.Language"
                multiple="multiple" class="select-multiple">
            @foreach (var group in model.GroupProducts)
            {
                if (group.HasGroupName)
                {
                    <optgroup label="@group.Group.Name">
                        @foreach (var product in group.Products)
                        {
                            <option value="@product.Value" @(product.Selected ? " selected=\"selected\"" : string.Empty) data-isnested="1">@product.Text</option>
                        }
                    </optgroup>
                }
                else
                {
                    foreach (var product in group.Products)
                    {
                        <option value="@product.Value" @(product.Selected ? " selected=\"selected\"" : string.Empty)>@product.Text</option>
                    }
                }
            }
        </select>
        <input type="hidden" name="ProductIds" id="product-ids" value="@model.ProductIds" />
    </div>
}
@using Fanex.BetList.Core.Entities
@using Fanex.BetList.Core.Builder

@helper Render(IBetListHTMLBuilder builder, ITicket ticket)
{
    <td class="trans-block text-center nonbreak">
        <div class="time">
            @(new HtmlString(builder.BuildTrans(ticket)))
        </div>        
    </td>
}
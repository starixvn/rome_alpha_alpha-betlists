@using Fanex.BetList.Core.Entities
@using Fanex.BetList.Core.Builder

@helper Render(IBetListHTMLBuilder builder, ITicket ticket, ITicketHelper helper, List<ITicketData> ticketData, bool isShowVNIP)
{
    <td class="status-block">
        @(new HtmlString(builder.BuildStatus(ticket, helper, ticketData, isShowVNIP)))
    </td>
}
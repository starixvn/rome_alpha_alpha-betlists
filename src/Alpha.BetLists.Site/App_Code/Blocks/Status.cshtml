@using Fanex.BetList.Core.Entities
@using Fanex.BetList.Core.Builder
@using Alpha.BetLists.Models

@helper Render(IBetListHTMLBuilder builder, TicketDto ticket, ITicketHelper helper, List<ITicketData> ticketData, bool isShowVNIP)
{
    <td class="status-block text-center sport-@(ticket.SportTypeId)">
        @(new HtmlString(builder.BuildStatus(ticket, helper, ticketData, isShowVNIP)))
        @if (!string.IsNullOrWhiteSpace(ticket.Country))
        {
            <div class="country">@ticket.Country</div>
        }
    </td>
}
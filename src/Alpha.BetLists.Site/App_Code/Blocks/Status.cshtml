@using Fanex.BetList.Core.Entities
@using Fanex.BetList.Core.Builder

@helper Render(BetListHTMLBuilder builder, ITicket ticket, ITicketHelper helper, List<ITicketData> ticketData, bool isShowVNIP)
{
    <td class="status-block">
        @builder.BuildStatus(ticket, helper, ticketData, isShowVNIP)
    </td>
}
@using Fanex.BetList.Core.Entities
@using Alpha.BetLists.Builders.HtmlBuilders
@using Alpha.BetLists.Models

@helper Render(ITicket ticket, List<ITicketData> ticketData, UserLevel custLevel)
{

if (custLevel.IsAgentLevel())
{
        <td class="position-taking-block text-right">
            @(new HtmlString(BetListHtmlBuilderExt.BuildPTCom(ticket, ticketData, UserLevel.Agent)))
        </td>
}
else if (custLevel.IsMasterLevel())
{
        <td class="position-taking-block text-right">
            @(new HtmlString(BetListHtmlBuilderExt.BuildPTCom(ticket, ticketData, UserLevel.Master)))
        </td>
}
else if (custLevel.IsSuperLevel())
{
        <td class="position-taking-block text-right">
            @(new HtmlString(BetListHtmlBuilderExt.BuildPTCom(ticket, ticketData, UserLevel.Super)))
        </td>
}

}
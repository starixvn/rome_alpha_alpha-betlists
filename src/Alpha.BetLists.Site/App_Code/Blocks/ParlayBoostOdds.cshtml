@helper Render(string originalOdds, string boostOdds, string boostRate)
{   
    <span class="underdog strikethrough">@originalOdds</span>
    <br/>
    <span class="oddstype">
        <span class="underdog">@boostOdds</span>
        <br/>
        <span class="boostrate">
            <span class="icon-boost"></span>
            @boostRate
        </span>
    </span>    
}
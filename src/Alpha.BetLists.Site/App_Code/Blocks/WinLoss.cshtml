@using Fanex.BetList.Core.Entities
@using Alpha.BetLists.Site.ViewModels.Blocks

@helper Render(ITicket ticket)
{
var model = new WinLossBlockViewModel(ticket);

    <td class="win-loss-block text-right nonbreak">
        <div>
            <span class="win-loss">@(new HtmlString(model.WinLoss))</span>
        </div>
        @if (model.CommVisibility)
        {
            <div>
                <span class="comm">@(new HtmlString(model.Comm))</span>
            </div>
        }
    </td>
}
@using Alpha.BetLists.Site.ViewModels.WinLossByMatch

@model WinLossByMatchViewModel

@{
    ViewBag.Title = "Win Loss By Match Bet List";
}

<div class="bl_title">

    <div class="box">
        <div>
            @Model.Title
        </div>
        <div>
            @{
                var notes = new List<string>() {
                    Resources.ipnote,
                    Resources.CommissionRoundNote
                    };

                if (Model.ShowContributionAmountRoundNote)
                {
                    notes.Add(Resources.ContributionAmountRoundNote);
                }
            }

            @Html.Partial("IconInformation", notes)
        </div>

        <div class="push">
            <div class="bl-export-excel">
                <a id="icon-excel" class="icon icon-excel" title="@Resources.ExportToExcel"
                   href="@Url.Action("Excel", $"{Alpha.BetLists.Configurations.AppSettings.BetlistRouting}WinLossByMatch",
                new
                {
                    CustName = Model.CustName,
                    CustId = Model.CustId,
                    ProductIds = Model.ProductsId,
                    FromDate = Model.FromDate,
                    ToDate = Model.ToDate,
                    BetType = Model.BetType,
                    LeagueId = Model.LeagueId,
                    MatchId = Model.MatchId,
                    Race = Model.Race,
                    LiveIndicator = Model.LiveIndicator,
                    CustLevelId = Model.CustLevelId
                })">
                </a>
            </div>

        </div>

    </div>
</div>

@Html.Partial("WinLossTable", Model)

@section Scripts{
    @StaticResources.RenderScripts($"~/{Alpha.BetLists.Configurations.AppSettings.BetlistRouting}assets/bundles/icon-note")
}

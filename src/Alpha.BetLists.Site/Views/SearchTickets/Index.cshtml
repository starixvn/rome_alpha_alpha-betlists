@using Alpha.BetLists.Site.ViewModels.SearchTickets
@model SearchTicketsViewModel
@{
    ViewBag.Title = "Win Loss Bet List";
}
@section Styles {
    @StaticResources.AssetStyles.Render("/bundles-v2/common/common")
    @StaticResources.RenderStyles($"~/{Alpha.BetLists.Configurations.AppSettings.BetlistRouting}assets/bundles/search-tickets/search-tickets")
}
<div class="bl_title">
    <div class="box">
        <div>
            @Model.Title
        </div>
        <div>
            @{
                var notes = new List<string>() {
                    Resources.ipnote,
                    Model.ViewDataInstructionMessage};
            }
            @Html.Partial("IconInformation", notes)
        </div>
        <div class="push">
        </div>
    </div>
</div>
<form class="form-inline search-ticket filter" role="form" id="betlist-form" action="@Url.Action("Index", $"{Alpha.BetLists.Configurations.AppSettings.BetlistRouting}SearchTickets")">
    @Html.Hidden("RefNo", Model.RefNo)
    <div class="form-group">
        <label>@Resources.RefNo<span class="red">*</span></label>

        <input type="number"
               id="ref-no"
               name="RefNo"
               class="form-control" />
    </div>
    <div class="form-group">
        <input type="submit" value="@Resources.Submit" class="btn-submit" id="submit-betList-form" />
    </div>

</form>
@Html.Hidden("MainDomain", Model.MainDomain)
@Html.Hidden("get-bets-url", @Url.Action("BetData", $"{Alpha.BetLists.Configurations.AppSettings.BetlistRouting}SearchTickets"))
@Html.Partial("WinLossTableNew", Model)

@section Scripts{
    @StaticResources.RenderScripts($"~/{Alpha.BetLists.Configurations.AppSettings.BetlistRouting}assets/bundles/icon-note")
    @StaticResources.RenderScripts($"~/{Alpha.BetLists.Configurations.AppSettings.BetlistRouting}assets/bundles/search-tickets/search-tickets")
}
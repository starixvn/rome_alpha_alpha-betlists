@using Fanex.BetList.Core.Entities
@using Alpha.BetLists.Configurations
@using Alpha.BetLists.Site.ViewModels.CasinoDetails
@using AlphaPlus.User.Models
@using Alpha.BetLists.Site.Constants;
@model CasinoDetailsViewModel
@{
    ViewBag.Title = Model.Title;
}
@section Styles{
    @StaticResources.AssetStyles.RenderWithDarkMode("/bundles/site-betlists/pagination")
}
<div class="space-fixed-title"></div>
<div class="bl_title no-border-bottom fixed-top">
    <div class="bl-export-excel">
        <a id="icon-excel" class="icon icon-excel" title="@Resources.ExportToExcel"
           href="@Url.Action("Excel", $"{Alpha.BetLists.Configurations.AppSettings.BetlistRouting}CasinoDetails",
                new { RefNo = Model.RefNo,
                    CustId=Model.CustId,
                    TransType = Model.TransType,
                    SportName=Model.SportName,
                    ProductId=Model.ProductId})">
        </a>
    </div>
</div>
<form class="form-inline hide" role="form" id="betlist-form">
    @Html.Hidden("RefNo", Model.RefNo)
    @Html.Hidden("CustId", Model.CustId)
    @Html.Hidden("TransType", Model.TransType)
    @Html.Hidden("SportName", Model.SportName)
    @Html.Hidden("ProductId", Model.ProductId)
</form>
<div id="table-container" class="combined-fixed-pagination-bottom">
    <table class="tblRpt tblRpt-bordered alternative-row-table width-100per tablesorter tblRpt-hover tbl-betlist" id="tbl-betlist">
        <thead>
            <tr>
                <th class="col-number">#</th>
                <th class="col-transtime">@Resources.transtime</th>
                <th>@Resources.choice</th>
                <th class="col-odds">@Resources.odds</th>
                <th class="col-stake">@Resources.stake</th>
                <th class="col-winloss">@Resources.lblWinLoss</th>
                <th class="col-status">@Resources.status</th>
                @if (Model.AllowToViewSuperPT)
                {
                    <th class="col-pt">@Resources.superPT/ @Resources.lblComm</th>
                }
                @if (Model.AllowToViewMasterPT)
                {
                    <th class="col-pt">@Resources.masterPT/ @Resources.lblComm</th>
                }
                <th class="col-pt">@Resources.agentPT/ @Resources.lblComm</th>
                <th class="col-platform">@Resources.platform</th>
            </tr>
        </thead>
        @if (Model.DetailData.Tickets.Any())
        {
            <tbody>
                @{
                    var i = Model.StartNo;
                    var isEvenRow = false;
                    var ticketData = new List<ITicketData>();
                    foreach (var ticket in Model.DetailData.Tickets)
                    {
                        <tr id="r@(ticket.TransId)" class="@(isEvenRow?"even-row":string.Empty)">
                            <td class='w-order text-center'>@i</td>
                            @Trans.Render(Model.Builder, ticket)
                            @Choice.Render(Model.Builder, ticket, Model.TicketHelper, ticketData, false)
                            @Odds.Render(Model.Builder, ticket, ticketData, Model.TicketHelper.GetOddsTypeNameById)
                            @Stake.Render(Model.Builder, ticket, Model.TicketHelper)
                            @WinLoss.Render(ticket)
                            @Status.Render(Model.Builder, (TicketDto)ticket, Model.TicketHelper, ticketData, Model.DisplayVNIP)
                            @if (Model.AllowToViewSuperPT)
                            {
                                @PositionTaking.Render(ticket, ticketData, UserLevel.Super)
                            }
                            @if (Model.AllowToViewMasterPT)
                            {
                                @PositionTaking.Render(ticket, ticketData, UserLevel.Master)
                            }
                            @PositionTaking.Render(ticket, ticketData, UserLevel.Agent)
                            @Platform.Render((ticket as TicketDto).Platform)
                        </tr>
                        isEvenRow = !isEvenRow;
                        i++;
                    }
                }
            </tbody>
        }
        else
        {
            <tbody>
                <tr>
                    <td colspan="@Model.TotalColumn" class="text-center">@Resources.NoInformationIsAvailable</td>
                </tr>
            </tbody>
        }
    </table>
</div>
@Pager.Render(Model.PagingViewModel)
@Html.Hidden("betlist-path", Response.ApplyAppPathModifier($"~/{Alpha.BetLists.Configurations.AppSettings.BetlistRouting}"))
@Html.Hidden("old-main-path", Session.IsCookieless ? $"/ex-main/(S({Session.SessionID}))/" : MicroSites.OldMainUrl("~/"))
@Html.Hidden("results-path", Session.IsCookieless ? $"/site-results/(S({Session.SessionID}))/" : AppPathHelper.GetAppPath(AppSettings.ResultAppPath, "~"))
@Html.Hidden("site-main-path", AppPathHelper.GetAppPath(AppSettings.MainAppPath, "~"))
@Html.Hidden("cust-id", Model.CustId)
@Html.Hidden("viewer-id", Model.ViewerId)
@Html.Hidden("viewer-level-id", Model.ViewerLevelId)
@section Scripts{
    @StaticResources.AssetScripts.Render("/bundles/site-betlists/pagination")
    @StaticResources.RenderScripts($"~/{Alpha.BetLists.Configurations.AppSettings.BetlistRouting}assets/bundles/casino-detail/casino-detail")
}

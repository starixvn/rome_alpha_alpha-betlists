@using Alpha.BetLists.Site.ViewModels.BetListByBetTypeAndMatch
@model BetListByBetTypeAndMatchViewModel
@{
    ViewBag.Title = Model.Title;
}
<div class="bl_title title-@ViewData["TitleLevel"]">
    @Model.Title
    <div class="bl-export-excel">
        <a id="icon-excel" class="icon icon-excel" title="@Resources.ExportToExcel"
           href="@Url.Action("Excel", "BetListByBetTypeAndMatch",
                new
                {
                    MatchId = Model.MatchId,
                    BetType = Model.BetType,
                    IsLive = Model.IsLive,
                    BetTeam = Model.BetTeam
                })">
        </a>
    </div>
</div>
@Html.Partial("TableWithoutWinLoss", Model)

@using Alpha.BetLists.Site.ViewModels.BetListByBetTypeAndMatch
@model BetListByBetTypeAndMatchViewModel
@{
    ViewBag.Title = Model.Title;
}

<div class="bl_title">
    <div class="box">
        <div>
            @Model.Title
        </div>
        <div>
            @Html.Partial("IconInformation", new List<string>() { Resources.ipnote, Resources.MemberWinNote})
        </div>

        <div class="push">
            <div class="bl-export-excel">
                <a id="icon-excel" class="icon icon-excel" title="@Resources.ExportToExcel"
                   href="@Url.Action("Excel", $"{Alpha.BetLists.Configurations.AppSettings.BetlistRouting}BetListByBetTypeAndMatch",
                new
                {
                    MatchId = Model.MatchId,
                    BetType = Model.BetType,
                    IsLive = Model.IsLive,
                    BetTeam = Model.BetTeam
                })">
                </a>
            </div>
        </div>
    </div>
</div>

@Html.Partial("TableWithoutWinLoss", Model)
@section Scripts{
    @StaticResources.RenderScripts($"~/{Alpha.BetLists.Configurations.AppSettings.BetlistRouting}assets/bundles/icon-note")
}
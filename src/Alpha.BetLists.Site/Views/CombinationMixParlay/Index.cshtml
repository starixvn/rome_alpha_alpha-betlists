@using Alpha.BetLists.Site.ViewModels.CombinationMixParlay
@model CombinationMixParlayViewModel
@{
    ViewBag.Title = "System Parlay";
}
@section Styles{
    @StaticResources.AssetStyles.RenderWithDarkMode($"/bundles/common/common-{Model.ViewerLevel.DisplayName}")
}
<div class="bl_title">
    @Model.Title
    <div class="bl-export-excel">
        <a id="icon-excel" class="icon icon-excel" title="@Resources.ExportToExcel"
           href="@Url.Action("Excel", "CombinationMixParlay")">
        </a>
    </div>
</div>
<div class="tab-content">
    <div role="tabpanel" class="tab-pane active" id="@ViewContext.RouteData.Values["controller"].ToString().ToLower()">
        @Html.Partial("TableWithoutWinLoss", Model)
    </div>
</div>

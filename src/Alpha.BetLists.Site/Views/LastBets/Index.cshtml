@using Alpha.BetLists.Site.ViewModels.LastBets
@using Alpha.BetLists.Constants
@using Alpha.BetLists.Configurations
@model LastBetsViewModel
@{
    ViewBag.Title = "Last Bets Monitoring";
}
@section Styles {
    @StaticResources.AssetStyles.RenderWithDarkMode($"/bundles/common/common-{Model.ViewerLevel.DisplayName}")
    @StaticResources.RenderStylesWithDarkMode($"~/{AppSettings.BetlistRouting}assets/bundles/last-bets")
}
<div class="bl_title">
    <div class="box">
        <div>
            @Resources.LastBets
        </div>
        <div>
            @Html.Partial("IconInformation", new List<string>() { Resources.ipnote })
        </div>
    </div>
</div>
<ul class="nav nav-tabs" role="tablist">
    <li role="presentation" class="tab-report-type @(Model.IsSelectedBetType(BetTypeIdConstants.AllBetTypes) ?"active":string.Empty)">
        @Html.ActionLink(Resources.AllBetTypes, "Index", $"{AppSettings.BetlistRouting}LastBets", new { BetType = BetTypeIdConstants.AllBetTypes, IsAutoRefresh = Model.IsAutoRefresh, PageSize = Model.PageSize }, new { id = "tab-all-bet-types" })
    </li>
    <li role="presentation" class="tab-report-type @(Model.IsSelectedBetType(BetTypeIdConstants.Handicap) ?"active":string.Empty)">
        @Html.ActionLink(Resources.Handicap, "Index", $"{AppSettings.BetlistRouting}LastBets", new { BetType = BetTypeIdConstants.Handicap, IsAutoRefresh = Model.IsAutoRefresh, PageSize = Model.PageSize }, new { id = "tab-handicap" })
    </li>
    <li role="presentation" class="tab-report-type @(Model.IsSelectedBetType(BetTypeIdConstants.OverUnder) ?"active":string.Empty)">
        @Html.ActionLink(Resources.OverUnder, "Index", $"{AppSettings.BetlistRouting}LastBets", new { BetType = BetTypeIdConstants.OverUnder, IsAutoRefresh = Model.IsAutoRefresh, PageSize = Model.PageSize }, new { id = "tab-over-under" })
    </li>
    <li role="presentation" class="tab-report-type @(Model.IsSelectedBetType(BetTypeIdConstants.OtherBetTypes) ?"active":string.Empty)">
        @Html.ActionLink(Resources.OtherBetTypes, "Index", $"{AppSettings.BetlistRouting}LastBets", new { BetType = BetTypeIdConstants.OtherBetTypes, IsAutoRefresh = Model.IsAutoRefresh, PageSize = Model.PageSize }, new { id = "tab-other-bet-types" })
    </li>
</ul>
<div class="space-between">
    <div class="page-section">
        <span>@Resources.Last</span>
        <ul class="page-size-container">
            <li id="page-size-10" class="page-size @(Model.IsSelectedPageSize(10) ? "active" : string.Empty)">10</li>
            <li id="page-size-20" class="page-size @(Model.IsSelectedPageSize(20) ? "active" : string.Empty)">20</li>
            <li id="page-size-30" class="page-size @(Model.IsSelectedPageSize(30) ? "active" : string.Empty)">30</li>
        </ul>
        <div id="btn-turn-off-on" class="btn-turn-off-on">
            <input type="checkbox" id="chb-switch" @(Model.IsAutoRefresh ? "checked" : string.Empty) />
            <label id="lbl-switch" class="switch">
                <span class="slider" data-on="@Resources.On" data-off="@Resources.Off"></span>
            </label>
            <span>@Resources.AutoRefresh</span>
        </div>
        <span id="loading-icon" class="loading-icon"></span>
    </div>
    @Common.SwitchVersionButton.NewView(Url.Action("Index", $"{AppSettings.BetlistRouting}MonitoringBets"))
</div>
<div id="msg-error" class="msg msg-error hide">
    @Resources.FunctionTurnOffError
</div>
<div id="bet-list-table-container">
</div>

<input id="bet-type" type="hidden" value="@Model.BetType" />
<input id="is-auto-refresh" type="hidden" value="@(Model.IsAutoRefresh ? "true":"false")" />
<input id="get-bets-url" type="hidden" value="@Url.Action("BetData",$"{AppSettings.BetlistRouting}LastBets")" />
<input id="last-trans-id-cache-key" type="hidden" value="@Model.LastTransIdCacheKey" />
<input id="latest-trans-id-cache-key" type="hidden" value="@Model.LatestTransIdCacheKey" />
<input id="reset-last-trans-id" type="hidden" value="@Model.ResetLastTransId.ToString()" />

@Html.Hidden("betlist-path", Response.ApplyAppPathModifier($"~/{AppSettings.BetlistRouting}"))
@Html.Hidden("old-main-path", Model.OldMainPath)
@Html.Hidden("totalbets-forecast-path", Model.TotalBetsForecastPath)
@Html.Hidden("cust-id", Model.CustId)
@Html.Hidden("viewer-id", Model.ViewerIdOrViewerAdminId)
@Html.Hidden("viewer-level-id", Model.ViewerLevelId)

@section Scripts {
    @StaticResources.AssetScripts.Render("/bundles/site-betlists/last-bets")
    @StaticResources.RenderScripts($"~/{AppSettings.BetlistRouting}assets/bundles/last-bets")
    @StaticResources.RenderScripts($"~/{Alpha.BetLists.Configurations.AppSettings.BetlistRouting}assets/bundles/icon-note")
}

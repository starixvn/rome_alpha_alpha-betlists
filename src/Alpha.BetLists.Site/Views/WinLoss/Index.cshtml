@using Alpha.BetLists.Site.ViewModels.WinLoss

@model WinLossViewModel

@{
    ViewBag.Title = "Win Loss Bet List";
}
@if (!string.IsNullOrWhiteSpace(Model.BetlistOutputParams.ErrMsg))
{
    <div style="border: 1px solid #f00; color: #f00; padding: 10px">@Model.BetlistOutputParams.ErrMsg</div>
}
<div class="bl_title">

    <div class="box">
        <div>
            @Model.Title
        </div>
        <div>
            @{
                var notes = new List<string>() {
                    Resources.ipnote,
                    Resources.CommissionRoundNote
                    };

                if (Model.ShowContributionAmountRoundNote)
                {
                    notes.Add(Resources.ContributionAmountRoundNote);
                }
            }

            @Html.Partial("IconInformation", notes)
        </div>

        <div class="push">
            <div class="bl-export-excel">
                <a id="icon-excel" class="icon icon-excel" title="@Resources.ExportToExcel"
                   href="@Url.Action("Excel", $"{Alpha.BetLists.Configurations.AppSettings.BetlistRouting}WinLoss",
                new { CustName = Model.CustName,
                    CustId = Model.CustId,
                    ProductIds = Model.ProductsId,
                    ResourceIds = Model.ResourceIds,
                    FromDate = Model.FromDate,
                    ToDate = Model.ToDate,
                    IsGroupHeadline = Model.IsGroupHeadline
                })">
                </a>
            </div>
        </div>
    </div>

</div>
@Html.Partial("WinLossTable", Model)

@section Scripts{
    @StaticResources.RenderScripts($"~/{Alpha.BetLists.Configurations.AppSettings.BetlistRouting}assets/bundles/icon-note")
}
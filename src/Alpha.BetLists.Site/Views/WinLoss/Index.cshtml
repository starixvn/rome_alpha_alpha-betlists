@using Alpha.BetLists.Site.ViewModels.WinLoss

@model WinLossViewModel

@{
    ViewBag.Title = "Win Loss Bet List";
}

<div class="bl_title">
    @Model.Title
    <div class="bl-export-excel">
        <a id="icon-excel" class="icon icon-excel" title="@Resources.ExportToExcel"
           href="@Url.Action("Excel", "WinLoss",
                new { CustName = Model.CustName,
                    CustId = Model.CustId,
                    ProductIds = Model.ProductsId,
                    ResourceIds = Model.ResourceIds,
                    FromDate = Model.FromDate,
                    ToDate = Model.ToDate })">
        </a>
    </div>
</div>
@Html.Partial("WinLossTable", Model)
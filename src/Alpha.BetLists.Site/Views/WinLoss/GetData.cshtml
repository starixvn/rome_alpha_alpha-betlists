@using Alpha.BetLists.Site.ViewModels.WinLoss
@model WinLossViewModel
@if (Model.BetListData.Total > 0)
{
    var index = 0;
    foreach (var ticket in Model.BetListData.Tickets)
    {
        <tr id="r@(ticket.TransId)">
            <td class='w-order text-center'>@(++index)</td>
            @Trans.Render(Model.Builder, ticket)
            @Choice.Render(Model.Builder, ticket, Model.TicketHelper, Model.BetListData.TicketData, Model.CanViewScoreMap(ticket))
            @Odds.Render(Model.Builder, ticket, Model.BetListData.TicketData, Model.TicketHelper.GetOddsTypeNameById)
            @Stake.Render(Model.Builder, ticket, Model.TicketHelper)
            @WinLoss.Render(ticket)
            @Status.Render(Model.Builder, ticket, Model.TicketHelper, Model.BetListData.TicketData, Model.DisplayVNIP)
            @if (Model.AllowToViewSuperPT)
            {
                @PositionTaking.Render(ticket, Model.BetListData.TicketData, UserLevel.Super)
            }
            @if (Model.AllowToViewMasterPT)
            {
                @PositionTaking.Render(ticket, Model.BetListData.TicketData, UserLevel.Master)
            }
            @PositionTaking.Render(ticket, Model.BetListData.TicketData, UserLevel.Agent)
        </tr>
    }
    @Common.Footer.Render(
        Model.Footer.SubTotalColSpan,
        Model.Footer.StatusColSpan,
        Model.Footer.SubTotalWinLoss,
        Model.Footer.SubTotalCommission,
        Model.Footer.Total);
}
else
{
    <tr>
        @if (string.IsNullOrWhiteSpace(Model.BetlistOutputParams.ErrMsg))
        {
            <td colspan="@Model.TotalColumn" class="text-center">@Resources.NoInformationIsAvailable</td>
        }
        else
        {
            <td colspan="@Model.TotalColumn" class="text-center error-exceed-row">@Model.BetlistOutputParams.ErrMsg</td>
        }
    </tr>
}

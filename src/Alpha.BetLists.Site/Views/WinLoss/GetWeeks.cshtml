@using Alpha.BetLists.Extensions;
@using Alpha.BetLists.Site.ViewModels.Components
@model IEnumerable<WeekSelectionViewModel>
@foreach (var item in Model)
{
    if (item.IsEnable)
    {
        <a href="javascript:;"
           class="label-week@(item.IsActive ? " active" : string.Empty)"
           data-fromdate="@item.FromDate.ToShortDateWithSlash()"
           data-todate="@item.ToDate.ToShortDateWithSlash()">@item.Display</a>
    }
    else
    {
        <a href="javascript:;" class="label-week disabled">@item.Display</a>
    }
}
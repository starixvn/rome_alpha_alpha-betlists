@using Alpha.BetLists.Site.ViewModels.RiskAnalysisIPMatching

@model RiskAnalysisIPMatchingViewModel

@{
    ViewBag.Title = "IP Matching List";
}

@if (Model != null)
{
    <div class="bl_title">
        <div class="box">
            <div>
                @Model.Title
            </div>
            <div>
                @Html.Partial("IconInformation", new List<string>() { Resources.ipnote, Resources.CommissionRoundNote })
            </div>

            <div class="push">
                <div class="bl-export-excel">
                    <a id="icon-excel" class="icon icon-excel" title="@Resources.ExportToExcel"
                       href="@Url.Action("Excel", $"{Alpha.BetLists.Configurations.AppSettings.BetlistRouting}RiskAnalysisIPMatching", new { Date = Model.Date, IP = Model.IP })">
                    </a>
                </div>
            </div>
        </div>
    </div>

    @Html.Partial("WinLossTable", Model)

    @section Scripts{
        @StaticResources.RenderScripts($"~/{Alpha.BetLists.Configurations.AppSettings.BetlistRouting}assets/bundles/icon-note")
    }
}
else
{
    @Html.Partial("InvalidBetList")
}
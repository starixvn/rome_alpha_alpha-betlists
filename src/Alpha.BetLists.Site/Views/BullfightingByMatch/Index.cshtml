@model BullfightingByMatchViewModel
@{
    ViewBag.Title = "Bullfighting By Match";
}
<div class="bl_title">
    @Model.Title
    <div class="bl-export-excel">
        <a id="icon-excel" class="icon icon-excel" title="@Resources.ExportToExcel"
           href="@Url.Action("Excel", "BullfightingByMatch",
                new
                {
                    MatchId = Model.MatchId
                })">
        </a>
    </div>
</div>
@Html.Partial("WinLossTable", Model)

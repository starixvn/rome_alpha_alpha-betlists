<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewBag.Title ?? "Alpha - Bet Lists")</title>
    <link rel="shortcut icon" type="image/x-icon" href="~/favico.ico" />

    @StaticResources.AssetStyles.RenderCommonWithDarkMode("/bundles/common/common")
    @StaticResources.AssetStyles.RenderWithDarkMode("/bundles/site-betlists/default")
    @StaticResources.RenderStylesWithDarkMode($"~/{Alpha.BetLists.Configurations.AppSettings.BetlistRouting}assets/bundles/default")
    @RenderSection("Styles", required: false)
    @Alpha.Web.Helpers.GoogleAnalyticHepler.GtagScript()
</head>
<body data-theme="@(string.IsNullOrWhiteSpace(Sunplus.Agent.Model.Entities.UserSession.Current.DarkModeName) ? "light" : "dark")">
    @Alpha.Web.Helpers.GoogleAnalyticHepler.GtagNoScript()
    @RenderBody()
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/ajaxSetup")
    @StaticResources.AssetScripts.Render("/bundles/site-betlists/default")
    @StaticResources.RenderScripts($"~/{Alpha.BetLists.Configurations.AppSettings.BetlistRouting}assets/bundles/default")
    @Html.Partial("DetailsPopup")
    @RenderSection("Scripts", required: false)
    @Html.Hidden("MainDomain", Sunplus.Agent.Model.Entities.UserSession.Current.GetProperty<string>("MainDomain"))
    @Html.Hidden("BetListUrl", $"//{Request.Headers["Host"]}")
    @Html.Hidden("ReportDomain", $"//{Sunplus.Agent.Model.Entities.UserSession.Current.GetProperty<string>("ReportDomainSessionKey")}")
    @Html.Hidden("ReportSessionId", $"{Sunplus.Agent.Model.Entities.UserSession.Current.GetProperty<string>("ReportSessionID")}")
    @Html.Hidden("SessionId", $"{Session.SessionID}")
</body>
</html>
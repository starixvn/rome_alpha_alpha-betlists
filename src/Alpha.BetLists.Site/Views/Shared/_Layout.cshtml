<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewBag.Title ?? "Alpha - Bet Lists")</title>
    <link rel="shortcut icon" type="image/x-icon" href="~/favico.ico" />

    @StaticResources.AssetStyles.RenderCommon("/bundles/common/common")
    @StaticResources.AssetStyles.Render("/bundles/site-betlists/default")
    @StaticResources.RenderStyles("~/assets/bundles/default")
    @RenderSection("Styles", required: false)
</head>
<body>
    @RenderBody()
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/common")
    @StaticResources.AssetScripts.RenderCommon("/bundles/common/ajaxSetup")
    @StaticResources.AssetScripts.Render("/bundles/site-betlists/default")
    @StaticResources.RenderScripts("~/assets/bundles/default")
    @Html.Partial("DetailsPopup")
    @RenderSection("Scripts", required: false)

    @Alpha.Web.Helpers.GoogleAnalyticHepler.Render()
</body>
</html>
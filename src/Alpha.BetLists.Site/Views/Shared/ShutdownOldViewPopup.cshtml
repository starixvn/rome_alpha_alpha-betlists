<div class="modal fade" id="shutdown-old-view-modal" tabindex="-1" role="dialog" aria-labelledby="shutdown-old-view-modal">
    <div class="modal-dialog modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title"><span class="icon-information-outline" style="font-size: 20px">&nbsp;</span>@Resources.SwitchToNewView</h4>
            </div>
            <div class="modal-body">
                <p>@Html.Raw(Resources.ShutdownOldLastBetsMessage)</p>
                <label for="dont-show-again-model">
                    <input type="checkbox" id="dont-show-again-model" />@Resources.DoNotShowAgain
                </label>
            </div>
        </div>
    </div>
</div>

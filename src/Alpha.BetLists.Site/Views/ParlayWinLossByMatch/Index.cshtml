@using Alpha.BetLists.Site.ViewModels.ParlayWinLossByMatch

@model ParlayWinLossByMatchViewModel

@{
    ViewBag.Title = "Parlay Win Loss By Match Bet List";
}

<div class="bl_title">
    <div class="box">
        <div>
            @Model.Title
        </div>
        <div>
            @Html.Partial("IconInformation", new List<string>() { Resources.ipnote })
        </div>

        <div class="push">
            <div class="bl-export-excel">
                <a id="icon-excel" class="icon icon-excel" title="Excel"
                   href="@Url.Action("Excel", $"{Alpha.BetLists.Configurations.AppSettings.BetlistRouting}ParlayWinLossByMatch",
                new
                {
                    CustName = Model.CustName,
                    CustId = Model.CustId,
                    ProductIds = Model.ProductsId,
                    FromDate = Model.FromDate,
                    ToDate = Model.ToDate,
                    BetType = Model.BetType,
                    CustLevelId = Model.CustLevelId
                })">
                </a>
            </div>
        </div>
    </div>
</div>

@Html.Partial("WinLossTable", Model)

@section Scripts{
    @StaticResources.RenderScripts($"~/{Alpha.BetLists.Configurations.AppSettings.BetlistRouting}assets/bundles/icon-note")
}
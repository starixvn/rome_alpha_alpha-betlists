@using Alpha.BetLists.Site.ViewModels
@model BetListBaseViewModel
@{
    Layout = null;
}

@if (Model.BetListData != null && Model.BetListData.Tickets.Any())
{
    foreach (var ticket in Model.BetListData.Tickets)
    {
        <tr id="r@(ticket.TransId)">
            <td class="trans-block text-center">@ticket.TransId</td>
            <td class="trans-block text-center nonbreak">@ticket.TransDate.ToString()</td>
            <td>
                <div class="line-username">
                    <span>@ticket.UserName</span>
                    @if (ticket.IsInWatchlist)
                    {
                        <span class="icon-mywatchlist"></span>
                    }
                </div>
            </td>
            <td class="text-center">@ticket.BetType</td>
            @Choice.Render(Model.Builder, ticket, Model.TicketHelper, Model.BetListData.TicketData, Model.CanViewScoreMap(ticket))
            @Odds.Render(Model.Builder, ticket, Model.BetListData.TicketData, Model.TicketHelper.GetOddsTypeNameById)
            @Stake.Render(Model.Builder, ticket, Model.TicketHelper)
            @LastBetsStatus.Render(ticket, Model.TicketHelper, Model.DisplayVNIP)
        </tr>
    }
}
else
{
    @Common.NoInfomation.Render(Model.TotalColumn, false)
}
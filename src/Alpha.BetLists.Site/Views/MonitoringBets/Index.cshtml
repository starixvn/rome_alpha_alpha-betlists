@using Alpha.BetLists.Configurations
@using Alpha.BetLists.Site.ViewModels.MonitoringBets
@model MonitoringBetsViewModel
@{
    ViewBag.Title = "Last Bets Monitoring";
}
@section Styles {
    @StaticResources.AssetStyles.RenderWithDarkMode("/bundles-v2/common/common")
    @StaticResources.AssetStyles.Render("/bundles-v2/site-betlists/monitoring-bets")
    @StaticResources.RenderStyles($"~/{AppSettings.BetlistRouting}assets/bundles/monitoring-bets/monitoring-bets")
}
@section Scripts {
    @StaticResources.AssetScripts.RenderCommon("/bundles-v2/site-betlists/monitoring-bets")
    @StaticResources.RenderScripts($"~/{AppSettings.BetlistRouting}assets/bundles/monitoring-bets/monitoring-bets")
}
<div class="flex">
    <div class="bl_title">
        @Resources.LastBets
        <div class="list-icon">
            <ul>
                <li><span class="icon-arrow-up-drop-circle icon-filter" title="Hide Filter"></span></li>
                @*<li><span class="icon-arrow-down-drop-circle icon-filter" title="Show Filter"></span></li>*@
            </ul>
        </div>
    </div>
    <form class="form-inline filter" role="form" id="form-monitoring-bets">
        <div class="form-group">

            <label class="label-form-control">@Resources.MyFilters</label>
            <select id="monitoring-bets-filter">
                @{
                    if (Model.Filters.Any())
                    {
                        foreach (var savedFilter in Model.Filters)
                        {
                            var selected = savedFilter.IsDefault ? "selected" : string.Empty;
                            var members = savedFilter.Members == "" ? "''" : savedFilter.Members;
                            <option value=@savedFilter.FilterId @selected
                                    data-filter-id=@savedFilter.FilterId
                                    data-members=@members
                                    data-bet-types=@savedFilter.BetTypes
                                    data-sport-types=@savedFilter.SportTypes
                                    data-leagues=@savedFilter.Leagues
                                    data-event-status=@savedFilter.EventStatus
                                    data-stake=@savedFilter.Stake
                                    data-filter-by-member=@savedFilter.FilterByMembers>
                                @savedFilter.FilterName
                            </option>
                        }
                    }
                }
            </select>
        </div>
        <div class="form-group">
            @Html.ActionLink(Resources.ManageFilters, "ManageFilters", $"{AppSettings.BetlistRouting}MonitoringBets", null, new { target = "main", @class = "button-link" })
        </div>
        <div class="form-group">
            <label class="label-form-control">@Resources.MostRecentTickets</label>
            @Html.DropDownList("most-recent-tickets", Model.MostRecentTickets, new { id = "most-recent-tickets" })
        </div>
        @AutoRefresh.Render(new[] { 30, 60, 90 })
        <div class="form-group">
            @Html.ActionLink(Resources.FilterConfiguration, "FilterConfiguration", $"{AppSettings.BetlistRouting}MonitoringBets", null, new { target = "main", @class = "button-link" })
        </div>
        <div class="form-group">
            <span class="ic-copy" title="@Resources.Copy" id="icon-copy"></span>
        </div>
    </form>

    <div id="msg-error" class="msg msg-error hide">
        @Resources.FunctionTurnOffError
    </div>

    <div class="scrollable">
        <table class="tb tb-bordered tb-freeze-header w-full" id="tbl-betlist">
            <thead>
                <tr>
                    <th class="col-number">@Resources.RefNo</th>
                    <th class="col-transtime">@Resources.transtime</th>
                    <th class="col-member">@Resources.Username</th>
                    <th>@Resources.BetType</th>
                    <th>@Resources.choice</th>
                    <th class="col-odds">@Resources.odds</th>
                    <th class="col-stake">@Resources.stake</th>
                    <th class="col-status">@Resources.IP</th>
                </tr>
            </thead>
            <tbody id="bet-list-table-container">
                @if (Model.BetListData != null && Model.BetListData.Tickets.Any())
                {
                    foreach (var ticket in Model.BetListData.Tickets)
                    {
                        <tr id="r@(ticket.TransId)">
                            <td class='w-order text-center'>@ticket.RefNo</td>
                            <td class="trans-block text-center nonbreak">
                                <div class="time">@ticket.TransDate.ToString()</div>
                            </td>
                            <td class="text-center">@ticket.UserName</td>
                            <td class="text-center">@ticket.BetType</td>
                            @Choice.Render(Model.Builder, ticket, Model.TicketHelper, Model.BetListData.TicketData, Model.CanViewScoreMap(ticket))
                            @Odds.Render(Model.Builder, ticket, Model.BetListData.TicketData, Model.TicketHelper.GetOddsTypeNameById)
                            @Stake.Render(Model.Builder, ticket, Model.TicketHelper)
                            @LastBetsStatus.Render(ticket, Model.TicketHelper, Model.DisplayVNIP)
                        </tr>
                    }
                }
                else
                {
                    @Common.NoInfomation.Render(Model.TotalColumn, false)
                }
            </tbody>
        </table>
    </div>
    <input id="get-bets-url" type="hidden" value="@Url.Action("BetData", $"{AppSettings.BetlistRouting}MonitoringBets")" />
    <input id="last-trans-id-cache-key-by-filter" type="hidden" value="@Model.LastTransIdCacheKeyByFilter" />
    <input id="latest-trans-id-cache-key-by-filter" type="hidden" value="@Model.LatestTransIdCacheKeyByFilter" />

</div>
@Html.Hidden("hidden-On", Resources.On)
@Html.Hidden("hidden-Off", Resources.Off)
@Html.Hidden("hidden-CopyText", Resources.Copy)
@Html.Hidden("hidden-CopiedText", Resources.Copied)

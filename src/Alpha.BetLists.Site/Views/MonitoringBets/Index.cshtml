@using Alpha.BetLists.Configurations
@using Alpha.BetLists.Site.ViewModels.MonitoringBets
@model MonitoringBetsViewModel
@{
    ViewBag.Title = "Last Bets Monitoring";
}
@section Styles {
    @StaticResources.AssetStyles.RenderWithDarkMode("/bundles/site-betlists/filter")
    @StaticResources.RenderStyles($"~/{AppSettings.BetlistRouting}assets/bundles/filter")
    @*@StaticResources.RenderStylesWithDarkMode($"~/{AppSettings.BetlistRouting}assets/bundles/last-bets")*@
    @StaticResources.RenderStylesWithDarkMode($"~/{AppSettings.BetlistRouting}assets/bundles/last-bets-new")
}
@section Scripts {
    @*@StaticResources.AssetScripts.Render("/bundles/site-betlists/last-bets")*@
    @StaticResources.AssetScripts.RenderCommon("/bundles/site-betlists/filter")
    @StaticResources.RenderScripts($"~/{AppSettings.BetlistRouting}assets/bundles/monitoring-bets/monitoring-bets")
}
<div class="flex">
    <div class="bl_title">
        @Resources.LastBets
        <div class="list-icon" id="betlist-filter">
            <ul>
                <li class="showfilter-element"><span class="icon-arrow-up-drop-circle icon-filter" title="Hide Filter"></span></li>
                <li class="hidefilter-element"><span class="icon-arrow-down-drop-circle icon-filter" title="Show Filter"></span></li>
            </ul>
        </div>
    </div>
    <form class="form-inline filter" role="form">
        <div class="form-group">
            <label>Saved Filter</label>
            <select id="monitoring-bets-filter">
                <option value="Default" selected>Default</option>
                <option value="Stake above 800">Stake above 800</option>
                <option value="New filter name 1">New filter name 1</option>
                <option value="New filter name 2">New filter name 2</option>
                <option value="New filter name 3">New filter name 3</option>
            </select>
        </div>
        <div class="form-group">
            <a href="javascript:;">Manage Filters</a>
        </div>
        <div class="form-group">
            <label>Show Top Tickets</label>
            <select id="monitoring-bets-top">
                <option value="10" selected>10</option>
                <option value="20">20</option>
                <option value="30">30</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
        </div>
        <div class="form-group">
            <input type="submit" value="@Resources.Submit" class="btn-submit" />
        </div>
        @AutoRefresh.Render(new[] { 30, 60, 90 })
        <div class="form-group">
            <a href="FilterConfiguration" target="main">Filter Configuration</a>
        </div>
    </form>

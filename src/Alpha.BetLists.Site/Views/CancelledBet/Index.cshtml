@using Alpha.BetLists.Site.ViewModels.CancelledBet

@model CancelledBetViewModel

@section Styles{
@StaticResources.AssetStyles.Render("/bundles/site-betlists/pagination")
    @StaticResources.AssetStyles.Render("/bundles/site-betlists/filter")
    @StaticResources.RenderStyles("~/assets/bundles/filter")
}

@{
    ViewBag.Title = "Cancelled Bet List";
}

<div class="bl_title">
    @Model.Title

    <div class="list-icon" id="betlist-filter">
        <ul>
            <li class="showfilter-element"><span class="icon-arrow-up-drop-circle icon-filter" title="@Resources.HideFilter"></span></li>
            <li class="hidefilter-element"><span class="icon-arrow-down-drop-circle icon-filter" title="@Resources.ShowFilter"></span></li>
        </ul>
    </div>


</div>

<form class="form-inline filter cancelled-bet @(Model.IsFilterVisible ? string.Empty : "hide")" role="form" id="betlist-form">
    @Html.Hidden("IsFilterVisible", Model.IsFilterVisible ? "true" : "false")
    @ProductMultiSelection.Render(Model.ProductMultiSelectionViewModel)
    
    @StatusMultiSelection.Render(Model.StatusMultiSelectionViewModel)

    @DateRangePicker.Render(Model.DateRangePickerViewModel)    

    <div class="form-group">
        <span id="icon-excel" class="icon-excel" title="@Resources.ExportToExcel"></span>
    </div>

    <div class="note">
        <span class="star">*</span>@Model.ViewDataInstructionMessage
    </div>
</form>

<table class="tblRpt tblRpt-bordered tblRpt-striped width-100per tablesorter tblRpt-hover tbl-betlist">
    <thead>
        <tr>
            <th class="col-number">#</th>
            <th class="col-member">@Resources.member</th>
            <th class="col-transtime">@Resources.transtime</th>
            <th>@Resources.choice</th>
            <th class="col-odds">@Resources.odds</th>
            <th class="col-stake">@Resources.stake</th>
            <th class="col-status">@Resources.status</th>
        </tr>
    </thead>
    @if (Model.BetListData.Tickets.Any())
    {
        <tbody>
            @for (int i = 0; i < Model.BetListData.Total; i++)
            {
                var ticket = Model.BetListData.Tickets.ElementAt(i);

                <tr id="r@(ticket.TransId)">
                    <td class='w-order text-center'>@Model.BuildNo(i)</td>
                    <td class="text-center">@ticket.UserName</td>
                    @Trans.Render(Model.Builder, ticket)
                    @Choice.Render(Model.Builder, ticket, Model.TicketHelper, Model.BetListData.TicketData, false)
                    @Odds.Render(Model.Builder, ticket, Model.BetListData.TicketData, Model.TicketHelper.GetOddsTypeNameById)
                    @Stake.Render(Model.Builder, ticket, Model.TicketHelper)
                    @Status.Render(Model.Builder, ticket, Model.TicketHelper, Model.BetListData.TicketData, Model.DisplayVNIP)
                </tr>
            }
        </tbody>
    }
    else
    {
        @Common.NoInfomation.Render(Model.TotalColumn)
    }
</table>

@Pager.Render(Model.PagerViewModel)

<form class="form-inline hide" role="form" id="export-excel-form"
      action="@Url.Action("Excel", "CancelledBet")">
    @Html.Hidden("CustId", Model.CustId)
    @Html.Hidden("FromDate", Model.FromDate)
    @Html.Hidden("ToDate", Model.ToDate)
    @Html.Hidden("ProductIds", Model.ProductsId)
    @Html.Hidden("StatusIds", Model.StatusIds)    
</form>

@Html.Hidden("betlist-path", HttpContext.Current.Response.ApplyAppPathModifier("~/"))
@Html.Hidden("old-main-path", Model.OldMainPath)
@Html.Hidden("results-path", Model.ResultsPath)
@Html.Hidden("totalbets-forecast-path", Model.TotalBetsForecastPath)
@section Scripts{
    @StaticResources.AssetScripts.Render("/bundles/site-betlists/filter")
    @StaticResources.RenderScripts("~/assets/bundles/cancelled-betlist/cancelled-betlist")
@StaticResources.AssetScripts.Render("/bundles/site-betlists/pagination")
}